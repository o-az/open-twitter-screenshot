{
  "name": "nicexpost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "check": "bun format && bun lint && bun check:types",
    "start": "next start --hostname 0.0.0.0",
    "format": "oxfmt --config='oxfmt.config.ts' --write",
    "check:types": "tsrs --project tsconfig.json --noEmit",
    "lint": "oxlint --config='oxlint.config.ts' --type-aware --type-check --fix-dangerously"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "lucide-react": "^1.61.0",
    "modern-screenshot": "^4.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "tsrs": "^0.18.0-ts7.1.0-dev.20260929",
    "typed-query-selector": "^2.12.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
